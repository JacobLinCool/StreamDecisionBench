# Copy to .env (git-ignored) and fill in. `python -m streamdecisionbench.lite run` and the
# legacy `sdb` CLI load it automatically; variables already exported in your shell take precedence.

# Jev (TypeSafe): `lite run --provider typesafe`, or the legacy jev:<model> adapter.
TYPESAFE_API_KEY=
# Optional: pin a model version or point at another Jev-compatible endpoint.
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Wity native decisions: `lite run --provider wity --model wity-1`.
# Get a key: https://wity.alphanimble.com/docs/quickstart
WITY_API_KEY=
# Optional: override the native API base URL (without /v1/systemone).
# WITY_BASE_URL=https://wity-proxy-production-2c33.up.railway.app

# GPT settings (OpenAI Responses API): `lite run` with the default provider, or the legacy
# openai:<model> adapter. OPENAI_BASE_URL is optional (another Responses-API-compatible endpoint).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Cloudflare Workers AI: `lite run --provider cloudflare --model clef`.
# Dashboard: Workers AI -> Use REST API -> Create a Workers AI API Token.
# Token permissions: Workers AI Read and Edit, scoped to the account below.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Optional, for the legacy anthropic:<model> adapter only.
# ANTHROPIC_API_KEY=
